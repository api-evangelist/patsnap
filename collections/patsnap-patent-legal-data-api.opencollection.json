{
  "opencollection": "1.0.0",
  "info": {
    "name": "Patsnap Open Platform AI Translation Patent Legal Data API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Patent Legal Data",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "P033 Standard Essential Patent (SEP)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://connect.patsnap.com/advanced-patent-data/sep-data",
            "params": [
              {
                "name": "patent_id",
                "value": "",
                "type": "query",
                "description": "patent_id"
              },
              {
                "name": "patent_number",
                "value": "",
                "type": "query",
                "description": "patent_number"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Receive SEP (Standard Essential Patent) data by patent_id or patent_number. This includes data source, standard ID, version, declaration date, title, and projects."
        },
        {
          "info": {
            "name": "P031 Customs record",
            "type": "http"
