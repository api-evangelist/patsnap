                "description": "patent_id"
              },
              {
                "name": "patent_number",
                "value": "",
                "type": "query",
                "description": "patent_number"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Receive customs data by patent_id or patent_number. This includes record number, record status, start date, end date, approval/opinion, product, and contact."
        },
        {
          "info": {
            "name": "P046 Status of Unified Patent Court",
            "type": "http"
