            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Receive the classification data for the three elements of patent technology, namely technical problem summary, technical benefit summary and technical approach summary, by providing the patent_id or patent_number."
        },
