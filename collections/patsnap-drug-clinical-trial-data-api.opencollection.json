        {
          "info": {
            "name": "B027 Clinical trial contact",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://connect.patsnap.com/synapse/clinical-trial/contact",
            "params": [
              {
                "name": "clinical_trial_id",
                "value": "",
                "type": "query",
                "description": "Clinical trial id, obtain this through clinical trial search interface"
              },
              {
                "name": "register_number",
                "value": "",
                "type": "query",
                "description": "register number"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Obtain clinical trial contact through clinical trial id or registry number"
        },
