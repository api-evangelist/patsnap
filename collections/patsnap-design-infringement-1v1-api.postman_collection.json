          "request": {
            "name": "AI67-2 Infringement Detection 1V1 - Search Query",
            "description": {
              "content": "According to the task_id generated by [AI67-1] Appearance Infringement Prevention Search - Task creation, query and export the appearance infringement prevention search results",
