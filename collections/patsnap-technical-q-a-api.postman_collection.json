        {
          "id": "a70988d5-1c14-423e-8264-ed9092e2f9d6",
          "name": "AI36-2 Technical Q&A - Query Task",
          "request": {
            "name": "AI36-2 Technical Q&A - Query Task",
            "description": {
              "content": "Based on the task_id returned by [AI36-1] submit task API, poll to get the execution result of technical Q&A task. Returns: task status, question analysis results, references and complete answer content.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ai",
                "technical-qa",
                "report"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
